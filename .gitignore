

# ==========================================
# MIS REGLAS PERSONALIZADAS (Tus carpetas privadas)
# ==========================================
# Pon aquí el nombre exacto de cualquier carpeta de tu PC que NO quieras subir
projects/




# ==========================================
# REGLAS PARA LENGUAJES DE PROGRAMACIÓN
# ==========================================

# --- Python ---
# Ignora las carpetas que crea Python automáticamente al ejecutar código
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
env/

# --- JavaScript / Node.js ---
# Ignora la carpeta de dependencias (¡es pesadísima y nunca se sube a GitHub!)
node_modules/
.npm/
npm-debug.log*

# --- Java / C / C++ ---
# Ignora los archivos compilados o ejecutables (.exe, .out) que se crean al correr el código
*.class
*.exe
*.o
*.out


# ==========================================
# REGLAS DEL SISTEMA OPERATIVO (Basado en tu archivo anterior)
# ==========================================
Thumbs.db
[Dd]esktop.ini
.DS_Store

# =========================================================
# ARCHIVOS TEMPORALES DE VISUAL STUDIO CODE Y EXTENSIONES
# =========================================================

# --- Carpetas del Núcleo de VS Code ---
# Guarda configuraciones locales del espacio de trabajo, tareas y depuradores (debuggers)
.vscode/
# Historial local de cambios (creado por extensiones de historial de archivos)
.history/
# Espacio de trabajo guardado por VS Code
*.code-workspace


# --- Temporales de HTML y Desarrollo Web en VS Code ---
# Carpetas y archivos de la extensión 'Live Server' (para ver cambios en vivo)
.live-server/
.liveserver/
# Cachés de formateadores de código y analizadores (Prettier, ESLint)
.prettiercache
.eslintcache


# --- Temporales de VS Code para PYTHON ---
# Carpetas que crea la extensión de Python de VS Code para analizar el código (IntelliSense)
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ropeproject/


# --- Temporales de VS Code para JAVASCRIPT / TYPESCRIPT ---
# Archivos de configuración de TypeScript y cachés de compilación en segundo plano
.tsbuildinfo


# --- Temporales de VS Code para JAVA ---
# Carpetas ocultas que genera la extensión 'Language Support for Java' para compilar en el editor
.project
.classpath
.factorypath
.settings/
bin/
